// VERSION CIBLE « PARTAGE PAR DOCUMENT » — NE PAS PUBLIER avant l'étape 5 de docs/PARTAGE.md.
// Identique à firestore.rules sauf : lecture de padletItems limitée aux fiches `shared == true` (hors administrateurs), champ `shared` booléen, collections `feedback` (avis) et `adminNotes` (notes privées).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Validation conservatrice : chaque contrôle ne s'applique que si le champ est présent (anciennes fiches compatibles).
    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }
    function validItem(data) {
      return optionalString(data, 'title', 300) && optionalString(data, 'theme', 120)
        && optionalString(data, 'summary', 20000) && optionalString(data, 'content', 100000)
        && optionalString(data, 'description', 20000) && optionalString(data, 'timelineTitle', 300)
        && optionalString(data, 'timelineContent', 20000) && optionalString(data, 'fileName', 300)
        && optionalString(data, 'filePath', 400) && optionalString(data, 'fileUrl', 2048)
        && optionalString(data, 'fileType', 150) && optionalString(data, 'date', 10)
        && optionalString(data, 'timelineDate', 10) && optionalString(data, 'color', 20)
        && optionalString(data, 'timelineColor', 20)
        && optionalString(data, 'pdfText', 20000) && optionalString(data, 'pdfTextStatus', 10)
        && (!('type' in data) || data.type in ['document', 'deadline'])
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 50) || (data.tags is string && data.tags.size() <= 2000))
        && (!('retentionMonths' in data) || (data.retentionMonths is number && data.retentionMonths >= 0 && data.retentionMonths <= 600) || (data.retentionMonths is string && data.retentionMonths.size() <= 4))
        && (!('fileSize' in data) || (data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 52428800))
        && (!('shared' in data) || data.shared is bool);
    }

    match /padletItems/{itemId} {
      // PARTAGE : un utilisateur ordinaire ne lit que les fiches `shared == true` (l'application filtre avec where('shared','==',true)).
      allow read: if request.auth != null
        && (request.auth.token.role == 'admin' || resource.data.shared == true);
      allow create, update: if request.auth != null
        && request.auth.token.role == 'admin'
        && validItem(request.resource.data);
      allow delete: if request.auth != null
        && request.auth.token.role == 'admin';
    }

    // Journal d'activité : ajout seulement, par un admin, à son propre nom et à l'heure du serveur. Jamais modifiable.
    match /activityLog/{eventId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow create: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.resource.data.keys().hasOnly(['action', 'resourceType', 'resourceId', 'result', 'operationId', 'userId', 'label', 'count', 'at', 'expireAt'])
        && request.resource.data.keys().hasAll(['action', 'resourceType', 'result', 'operationId', 'userId', 'at', 'expireAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.result in ['success', 'failure']
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt < request.time + duration.value(400, 'd');
      allow update, delete: if false;
    }

    // Notes privées des administrateurs sur une fiche (identifiant = celui de la fiche) : jamais lisibles par les utilisateurs.
    match /adminNotes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.token.role == 'admin';
      allow create, update: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.resource.data.keys().hasOnly(['text', 'updatedAt', 'updatedBy'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Avis des utilisateurs : tout compte connecté peut en envoyer (à son nom, heure du serveur, tailles limitées) ;
    // seuls les administrateurs les lisent ou les suppriment ; jamais modifiables.
    match /feedback/{feedbackId} {
      allow read, delete: if request.auth != null && request.auth.token.role == 'admin';
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'message', 'steps', 'page', 'appVersion', 'userId', 'at'])
        && request.resource.data.keys().hasAll(['type', 'message', 'userId', 'at'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.type in ['bug', 'suggestion', 'utilisation', 'autre']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && (!('steps' in request.resource.data) || (request.resource.data.steps is string && request.resource.data.steps.size() <= 1000))
        && (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 60))
        && (!('appVersion' in request.resource.data) || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20));
      allow update: if false;
    }

    // État de la dernière purge, écrit uniquement par la fonction serveur (compte de service).
    match /system/{docId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if false;
    }
  }
}
